DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Gmail SMTP for verify-email/reset-password emails.
# Use a Gmail App Password, not the account password, if 2FA is enabled.
AUTH_EMAIL=
AUTH_PASSWORD=

# First admin, created at startup ONLY if no admin user exists yet.
# If a user with ADMIN_EMAIL already exists, it is promoted to admin instead
# (password unchanged). After the first start you can remove ADMIN_PASSWORD;
# manage the password and further admins in /admin from then on.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional, default "Admin" / "ViMu"
ADMIN_NAME=
ADMIN_SURNAME=

# Used to build absolute links in emails (verify-email, reset-password)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
