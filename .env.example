DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Gmail SMTP for verify-email/reset-password emails.
# Use a Gmail App Password, not the account password, if 2FA is enabled.
AUTH_EMAIL=
AUTH_PASSWORD=

# Used to build absolute links in emails (verify-email, reset-password)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
