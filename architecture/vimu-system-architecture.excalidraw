    {
      "id": "el_5cfdoob74avm",
      "type": "text",
      "x": 2534,
      "y": 1508.0,
      "width": 604.8000000000001,
      "height": 243.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "el_85w6uyrlbuob"
